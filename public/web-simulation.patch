+'use client';
+
+import React from 'react';
+import { RunPhase, SimEdge, SimNode } from '@/lib/bgp-sim/types';
+import { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui/tooltip';
+
+interface Props {
+  nodes: SimNode[];
+  edges: SimEdge[];
+  defenderAs: number;
