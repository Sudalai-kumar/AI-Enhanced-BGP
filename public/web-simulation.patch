+          </div>
+
+          {/* events ≤ T */}
+          <div className="rounded-md border border-slate-800 bg-slate-900/40 p-2.5">
+            <div className="text-[10px] font-mono text-slate-500 mb-2 uppercase tracking-wider">
+              Event stream ≤ T · newest first
