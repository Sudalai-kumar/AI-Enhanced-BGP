+                  {detectedB ? 'detected it' : 'never detected it'}
+                  {detectedA && a?.run?.mttd != null ? ` — time-to-detect ${a.run.mttd}s vs ${b?.run?.mttd ?? '∞'}` : ''}
+                  {detectedB && !detectedA && b?.run?.mttd != null ? ` — time-to-detect ${b.run.mttd}s vs ∞` : ''}.
+                </>
+              ) : detectedA && detectedB ? (
