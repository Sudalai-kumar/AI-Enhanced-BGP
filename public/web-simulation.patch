+
+                <section>
+                  <div className="flex items-center gap-1.5 mb-2">
+                    <ListOrdered className="h-3 w-3 text-amber-400" />
+                    <h3 className="text-[10px] font-semibold tracking-wider text-slate-400 uppercase">
+                      RIB commit audit
+                    </h3>
+                    {ribEntries.length > 0 && (
